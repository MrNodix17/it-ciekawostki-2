<%- include('../partials/head', {title: 'Logowanie'}) %>
<%- include('../partials/nav', {currentPage: ''}) %>
<div class="auth-page">
  <div class="auth-card">
    <h1>Witaj z powrotem</h1>
    <p>Zaloguj się do swojego konta.</p>
    <%- include('../partials/flash') %>
    <form action="/auth/login" method="POST">
      <div class="form-group">
        <label class="form-label" for="email">Email</label>
        <input class="form-input" type="email" id="email" name="email" placeholder="ty@example.com" required autocomplete="email">
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Hasło</label>
        <input class="form-input" type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:var(--space-3)">Zaloguj się</button>
    </form>
    <div class="auth-footer">Nie masz konta? <a href="/auth/register">Zarejestruj się</a></div>
  </div>
</div>
<%- include('../partials/footer') %>
